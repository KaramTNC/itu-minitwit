version: "3.8"

networks:
  {{ app_name }}-network:
    driver: overlay

volumes:
  web-data-protection:

x-logging: &default_logging
  logging:
    driver: "json-file"
    options:
      max-size: "10m"
      max-file: "3"
      labels: "com.docker.swarm.service.name,com.docker.stack.namespace,com.docker.swarm.task.name,com.docker.compose.service"

x-rolling-update: &rolling_update
  replicas: {{ groups['web'] | length }}
  update_config:
    parallelism: 1
    delay: 30s
    order: stop-first
    failure_action: rollback
    monitor: 60s
    max_failure_ratio: 0
  rollback_config:
    parallelism: 1
    delay: 10s
    order: stop-first
    failure_action: pause
    monitor: 60s
    max_failure_ratio: 0
  restart_policy:
    condition: any
    delay: 5s
    max_attempts: 3
    window: 120s

services:
  itu-api-server:
    <<: *default_logging
    image: {{ docker_username }}/itu-api-server:{{ IMAGE_TAG | default('latest') }}
    ports:
      - "8080:8080"
      - "9185:9185"
    environment:
      - ASPNETCORE_URLS=http://+:8080
      - OTEL_PROMETHEUS_URI_PREFIX=http://*:9185/
      - DB_URL={{ lookup('env', 'DB_URL') }}
    healthcheck:
      test: ["CMD", "dotnet", "--info"]
      interval: 10s
      timeout: 5s
      start_period: 20s
      retries: 3
    networks:
      - {{ app_name }}-network
    deploy:
      <<: [*rolling_update]

  itu-web-server:
    <<: *default_logging
    image: {{ docker_username }}/itu-web-server:{{ IMAGE_TAG | default('latest') }}
    ports:
      - "5001:5001"
      - "9184:9184"
    environment:
      - ASPNETCORE_URLS=http://+:5001
      - OTEL_PROMETHEUS_URI_PREFIX=http://*:9184/
      - ASPNETCORE_DATA_PROTECTION_KEYS=/app/DataProtection-Keys
      - DB_URL={{ lookup('env', 'DB_URL') }}
    healthcheck:
      test: ["CMD", "dotnet", "--info"]
      interval: 10s
      timeout: 5s
      start_period: 20s
      retries: 3
    volumes:
      - web-data-protection:/app/DataProtection-Keys
    networks:
      - {{ app_name }}-network
    deploy:
      <<: [*rolling_update]
